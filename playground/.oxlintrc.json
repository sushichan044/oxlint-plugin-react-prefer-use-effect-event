{
  "jsPlugins": ["oxlint-plugin-react-prefer-use-effect-event"],
  "rules": {
    "oxlint-plugin-react-prefer-use-effect-event/prefer-use-effect-event": [
      "error",
      {
        "targets": [
          {
            "source": {
              "from": "package",
              "package": "some-notification-library",
              "name": "notify"
            },
            "handler": { "kind": "value" }
          },
          {
            "source": { "from": "package", "package": "react-router", "name": "useNavigate" },
            "handler": { "kind": "call-return" }
          },
          {
            "source": { "from": "package", "package": "@example/hooks", "name": "useMutation" },
            "handler": { "kind": "call-return-property", "properties": ["mutate"] }
          }
        ]
      }
    ]
  }
}
