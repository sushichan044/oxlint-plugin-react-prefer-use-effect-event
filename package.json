{
  "name": "oxlint-plugin-react-prefer-use-effect-event",
  "version": "0.0.0",
  "private": true,
  "description": "An Oxlint / ESLint plugin that suggests wrapping calls to event handlers of your choice inside `useEffect` with `useEffectEvent`.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "oxlint",
    "oxlint-plugin",
    "oxlintplugin",
    "react"
  ],
  "homepage": "https://github.com/sushichan044/oxlint-plugin-react-prefer-use-effect-event#readme",
  "bugs": {
    "url": "https://github.com/sushichan044/oxlint-plugin-react-prefer-use-effect-event/issues"
  },
  "license": "",
  "author": {
    "name": "sushichan044",
    "url": "https://github.com/sushichan044"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushichan044/oxlint-plugin-react-prefer-use-effect-event.git"
  },
  "funding": "https://github.com/sponsors/sushichan044",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "oxlint --max-warnings 0 --fix",
    "lint:check": "oxlint --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest --run",
    "test:unit": "pnpm run test --project unit",
    "test:e2e": "pnpm run build && pnpm run test --project e2e",
    "tidy": "pnpm run lint && pnpm run format && pnpm run test",
    "check": "pnpm run format:check && pnpm run lint:check && pnpm run test:unit && pnpm run test:e2e",
    "build": "tsdown",
    "docs:generate": "eslint-doc-generator",
    "pkg-pr-new": "pkg-pr-new publish --compact --comment=update --pnpm"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:prod",
    "empathic": "catalog:prod",
    "unrs-resolver": "catalog:prod"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "@virtual-live-lab/tsconfig": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-doc-generator": "catalog:dev",
    "fs-fixture": "^2.13.0",
    "oxc-parser": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "pkg-pr-new": "catalog:dev",
    "publint": "catalog:dev",
    "release-it": "catalog:dev",
    "release-it-pnpm": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-unused": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "packageManager": "pnpm@11.0.1"
}
